<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>For Thushara 💖</title>
<style>
    body {
        background: linear-gradient(to bottom right, #ff9a9e, #fad0c4);
        font-family: 'Georgia', serif;
        text-align: center;
        padding: 40px;
        overflow: hidden;
    }

    h1 {
        font-size: 2.5em;
        color: #8b0000;
    }

    #buttons {
        margin-top: 40px;
    }

    button {
        font-size: 1.5em;
        padding: 15px 30px;
        border-radius: 30px;
        border: none;
        cursor: pointer;
        margin: 10px;
    }

    #yesBtn {
        background-color: #ff3366;
        color: white;
    }

    #noBtn {
        background-color: #999;
        color: white;
        position: absolute;
    }

    #poem {
        display: none;
        margin-top: 30px;
        font-size: 1.2em;
        color: #4b0000;
        line-height: 1.6;
    }

    img {
        max-width: 90%;
        border-radius: 20px;
        margin-top: 25px;
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }

    .heart {
        position: absolute;
        color: red;
        font-size: 20px;
        animation: float 5s linear infinite;
    }

    @keyframes float {
        0% {
            transform: translateY(100vh);
            opacity: 1;
        }
        100% {
            transform: translateY(-10vh);
            opacity: 0;
        }
    }
</style>
</head>
<body>

<h1>Thushara… will you be my Valentine? 💌</h1>

<div id="buttons">
    <button id="yesBtn" onclick="showPoem()">YES 💖</button>
    <button id="noBtn" onmouseover="moveNo()">NO 💔</button>
</div>

<div id="poem">
    <h2>For Thushara 🌙</h2>
    <p>
    I chose you  
    the way the earth chooses its first rain,  
    not by logic,  
    but by thirst.<br><br>

    I chose you  
    like the heart chooses its language,  
    like silence chooses a song,  
    like the night chooses one window  
    to leave its light on.<br><br>

    Thushara,  
    if love were a homeland,  
    your name would be my passport.  
    If love were a season,  
    I would wait through every winter  
    just to arrive at your spring.<br><br>

    I do not ask you for forever  
    as a promise —  
    only as a direction.<br><br>

    So come,  
    be my Valentine,  
    and let the world learn  
    how gently  
    a soul can belong  
    to another soul.<br><br>

    — Prajith ❤️
    </p>

    <img src="darwish.jpg" alt="Love quote">
</div>

<script>
function moveNo() {
    const noBtn = document.getElementById("noBtn");
    const x = Math.random() * (window.innerWidth - 100);
    const y = Math.random() * (window.innerHeight - 50);
    noBtn.style.left = x + "px";
    noBtn.style.top = y + "px";
}

function showPoem() {
    document.getElementById("buttons").style.display = "none";
    document.getElementById("poem").style.display = "block";
    createHearts();
}

function createHearts() {
    setInterval(() => {
        const heart = document.createElement("div");
        heart.className = "heart";
        heart.innerHTML = "❤️";
        heart.style.left = Math.random() * window.innerWidth + "px";
        document.body.appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 5000);
    }, 300);
}
</script>

</body>
</html>
